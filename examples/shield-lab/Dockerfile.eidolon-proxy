FROM rust:1.95-bookworm AS builder
WORKDIR /workspace

COPY . .
RUN cargo build --release -p eidolon-proxy

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /workspace/target/release/eidolon-proxy /usr/local/bin/eidolon-proxy
EXPOSE 9102
ENTRYPOINT ["/usr/local/bin/eidolon-proxy"]
