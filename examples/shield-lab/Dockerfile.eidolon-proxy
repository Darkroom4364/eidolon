FROM rust:1.95-bookworm@sha256:6258907abe69656e41cd992e0b705cdcfabcbbe3db374f92ed2d47121282d4a1 AS builder
WORKDIR /workspace

COPY . .
RUN cargo build --release --locked -p eidolon-proxy --bin eidolon-proxy

FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /workspace/target/release/eidolon-proxy /usr/local/bin/eidolon-proxy
USER 65532:65532
EXPOSE 9102
ENTRYPOINT ["/usr/local/bin/eidolon-proxy"]
